# Garuda AI StudyHub - Backend Environment Variables
# Copy this file to .env and fill in the values

# Server
PORT=5000
NODE_ENV=development

# Database (MySQL)
# Create a database first: CREATE DATABASE garuda_studyhub;
DB_CLIENT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=garuda_studyhub
DB_USER=malli
DB_PASSWORD=8520

# JWT Secrets - CHANGE THESE IN PRODUCTION (use long random strings)
JWT_ACCESS_SECRET=garuda-access-secret-change-me-in-production-9f8e7d6c
JWT_REFRESH_SECRET=garuda-refresh-secret-change-me-in-production-1a2b3c4d

# Token lifetimes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Frontend origin (comma separated list allowed by CORS)
# For dev with Vite on port 5173:
FRONTEND_URL=http://localhost:5173

# Optional: AI provider. If OPENAI_API_KEY is set, /api/ai/* uses OpenAI.
# Otherwise the built-in offline assistant engine is used (works without a key).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Email (optional - used for forgot-password / verification links in production)
# In development, reset/verification tokens are returned in API responses.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=